{"nodes": [{"id": "readme_entropylens", "label": "entropylens: entropy-based statistical interpretability for PyTorch activations", "file_type": "concept", "source_file": "README.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measures statistical (not semantic) properties of activation distributions without touching the model: tracked forward pass is bitwise identical to untracked, nothing enters autograd. Explicit anti-claim by design: no semantic-interpretability claims - high entropy means only 'spread out over the batch'."}, {"id": "readme_batch_wise_entropy", "label": "batch_wise_entropy: per-neuron entropy across the batch", "file_type": "concept", "source_file": "README.md", "source_location": "Two metrics / Quickstart", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_per_example_entropy", "label": "per_example_entropy: per-example entropy across neurons (mandatory strategy)", "file_type": "concept", "source_file": "README.md", "source_location": "Two metrics / Quickstart", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The strategy (relu/abs) MUST be chosen explicitly because the two answers differ by up to 8.6x on the same input - a silent default would be a lie; unmapped modules raise an explicit error instead of guessing."}, {"id": "readme_entropytracker", "label": "EntropyTracker: non-invasive forward-hook training tracker", "file_type": "concept", "source_file": "README.md", "source_location": "Tracking a model during training", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_bitwise_invariance_guarantee", "label": "B1/B2/B3 bitwise-invariance guarantees (torch.equal, exact)", "file_type": "concept", "source_file": "README.md", "source_location": "Tracking a model during training", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Outputs and gradients with/without tracking are bitwise identical (tested with torch.equal, not allclose); entropy tensors never require grad; conv/4D maps are skipped with an explicit warning rather than silently computed."}, {"id": "readme_confidence_interval", "label": "confidence_interval: full-pipeline bootstrap 95% CI", "file_type": "concept", "source_file": "README.md", "source_location": "Uncertainty", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_honest_limitations", "label": "Honest limitations (documented, tested, not hidden)", "file_type": "concept", "source_file": "README.md", "source_location": "Honest limitations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design principle: limitations are documented and frozen as regression tests instead of hidden - reliable flag necessary-not-sufficient, zero-width CI on degenerate samples, Cauchy seed-variability, 99.92% winsorization ceiling."}, {"id": "readme_viz_dashboard", "label": "entropylens.viz: post-hoc matplotlib dashboards (layer trend, neuron heatmap, top-k)", "file_type": "concept", "source_file": "README.md", "source_location": "Visualization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Post-hoc rendering of tracked history (near-zero training overhead), matplotlib imported lazily; rankings exclude unreliable neurons and report how many were excluded; heatmaps grey out unreliable cells instead of pretending they are measurements."}], "edges": [{"source": "readme_entropylens", "target": "math_decisions_d1_quantile_winsorized_binning", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "How the estimator works / link to MATH_DECISIONS.md", "weight": 1.0}, {"source": "readme_entropylens", "target": "status_checklist_registry", "relation": "cites", "confidence":